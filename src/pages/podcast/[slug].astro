---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const episodi = await getCollection('episodi');
  return episodi.map(ep => ({
    params: { slug: ep.id },
    props: { ep },
  }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
---
<Base title={ep.data.title}>
<style>
  .ep-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 3rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--orange); }
  .ep-number-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ep-number-badge::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: var(--orange);
    display: block;
  }
  .ep-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.95;
    color: var(--cream);
    margin-bottom: 1.5rem;
  }
  .ep-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--divider);
    margin-bottom: 2rem;
  }
.ep-thumbnail {
  width: 100%;
  max-height: 480px;
  object-fit: cover;
  object-position: center;
    display: block;
    margin-bottom: 2rem;
    border-radius: 2px;
    filter: grayscale(20%) contrast(1.05);
  }
  .platform-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }
  .platform-link {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream);
    border: 1px solid var(--divider);
    padding: 0.6rem 1.2rem;
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .platform-link:hover { border-color: var(--orange); color: var(--orange); }
  .platform-link.instagram { border-color: rgba(232,80,10,0.3); }
  .ep-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgba(244,239,230,0.85);
  }
  .ep-body p { margin-bottom: 1.5rem; }
  .ep-body a { color: var(--orange); }
</style>

<div class="ep-hero">
  <a href="/podcast" class="back-link">← Tutti gli Episodi</a>
  <p class="ep-number-badge">Episodio {ep.data.number}</p>
  <h1 class="ep-title">{ep.data.title}</h1>
  <div class="ep-meta">
    <span>{new Date(ep.data.date).toLocaleDateString('it-IT', {day:'numeric',month:'long',year:'numeric'})}</span>
    <span>{ep.data.duration}</span>
  </div>
  {ep.data.thumbnail && (
    <img src={ep.data.thumbnail} alt={ep.data.title} class="ep-thumbnail" />
  )}
  <div class="platform-links">
    {ep.data.youtube && (
      <a href={ep.data.youtube} class="platform-link" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
        Guarda su YouTube
      </a>
    )}
    {ep.data.instagram && (
      <a href={ep.data.instagram} class="platform-link instagram" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        Instagram
      </a>
    )}
  </div>
</div>

<div class="ep-body">
  <Content />
</div>
</Base>
